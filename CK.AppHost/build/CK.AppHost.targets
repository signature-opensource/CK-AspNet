<Project>

  <!--
    The conventions of a host project "XXX.Host" (see the README of CK.AppHost):
    - It is an executable.
    - It references the Builder of its AppContext, a "{AppContext}.Builder" project (ReferenceOutputAssembly="false"):
      this only orders the builds. The Builder runs after its own build and writes the generated code in "$StObjGen" of
      the host. CKAppHostBuilder names it (a project name); by default, any referenced "*.Builder" project is it.
    - The generated code is compiled (included just before the compilation: on a clean build, the default glob of the
      source files is evaluated before the builder writes it).
    - The client applications ("Clients" folder) are built by their own tool chain: they are not part of the project.
  -->
  <ItemGroup>
    <Compile Remove="Clients/**" />
    <Content Remove="Clients/**" />
    <None Remove="Clients/**" />
  </ItemGroup>

  <Target Name="CKAppHostCheckProject" BeforeTargets="ResolveProjectReferences">
    <ItemGroup>
      <_CKAppHostBuilderReference Include="@(ProjectReference)" Condition=" '$(CKAppHostBuilder)' != '' And '%(Filename)' == '$(CKAppHostBuilder)' " />
      <_CKAppHostBuilderReference Include="@(ProjectReference)" Condition=" '$(CKAppHostBuilder)' == '' And $([System.String]::new('%(Filename)').EndsWith('.Builder')) " />
    </ItemGroup>
    <Error Condition=" '$(OutputType)' != 'Exe' And '$(OutputType)' != 'WinExe' "
           Text="CK.AppHost: '$(MSBuildProjectName)' must be an executable (its OutputType is '$(OutputType)'): only a host project references the CK.AppHost package." />
    <Error Condition=" '$(CKAppHostBuilder)' == '' And '@(_CKAppHostBuilderReference)' == '' "
           Text="CK.AppHost: '$(MSBuildProjectName)' must reference the Builder of its AppContext (it orders the builds: the Builder writes the generated code of the host): &lt;ProjectReference Include=&quot;..\{AppContext}.Builder\{AppContext}.Builder.csproj&quot; ReferenceOutputAssembly=&quot;false&quot; Private=&quot;false&quot; /&gt;." />
    <Error Condition=" '$(CKAppHostBuilder)' != '' And '@(_CKAppHostBuilderReference)' == '' "
           Text="CK.AppHost: '$(MSBuildProjectName)' must reference its Builder '$(CKAppHostBuilder)' (it orders the builds: the Builder writes the generated code of the host): &lt;ProjectReference Include=&quot;..\$(CKAppHostBuilder)\$(CKAppHostBuilder).csproj&quot; ReferenceOutputAssembly=&quot;false&quot; Private=&quot;false&quot; /&gt;." />
  </Target>

  <!--
    The publication of the host:
    - Its configuration ("appsettings.json", written by the builder) is published with it. The Web SDK does it (a json
      file is Content), the base SDK doesn't: it is added to the published files, evaluated after the build (the builder
      may have just written it).
    - "CK.AppHost.Published.json", next to the executable, tells CK.AppHost that the host is published: its content
      root is its own folder (appsettings.json, Clients), whatever the current directory of its process. It holds the
      effective properties of the publication (for the platform that receives it); CK.AppDeployment adds the deployment
      to it (its manifest).
  -->
  <Target Name="CKAppHostPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <!-- The file to start: the native executable of the host (".exe" for a Windows target), or its dll without it. -->
      <_CKAppHostExecutable>$(AssemblyName)$(_NativeExecutableExtension)</_CKAppHostExecutable>
      <_CKAppHostExecutable Condition=" '$(UseAppHost)' == 'false' ">$(TargetFileName)</_CKAppHostExecutable>
      <_CKAppHostPublished>{
  "Publish": {
    "Executable": "$(_CKAppHostExecutable)",
    "TargetFramework": "$(TargetFramework)",
    "RuntimeIdentifier": "$(RuntimeIdentifier)",
    "SelfContained": "$(SelfContained)",
    "PublishSingleFile": "$(PublishSingleFile)",
    "PublishTrimmed": "$(PublishTrimmed)",
    "PublishAot": "$(PublishAot)"
  }
}</_CKAppHostPublished>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)CK.AppHost.Published.json"
                      Lines="$(_CKAppHostPublished)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/appsettings.json"
                             Condition=" '$(UsingMicrosoftNETSdkWeb)' != 'true' And Exists('$(MSBuildProjectDirectory)/appsettings.json') "
                             RelativePath="appsettings.json"
                             CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(IntermediateOutputPath)CK.AppHost.Published.json"
                             RelativePath="CK.AppHost.Published.json"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="CKAppHostIncludeGeneratedCode" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$StObjGen/**/*.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
