<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Provides IStObjMap.CreateRunningAspNetServerAsync() (a party with its HttpEndpoint) and WebApplicationBuilder.CreateRunningAspNetServerAsync() (a standalone web application) that return a RunningAspNetServer with a Client to interact with it.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CK.Testing" Version="18.0.0-0.cris-auth.0.ci.6" />
    <!-- The engine of CK.AppIdentity: a BinPath with the HttpEndpoint feature has the PartyComponentOptionDirectory. -->
    <PackageReference Include="CK.AppIdentity.Engine" Version="3.0.0-0.cris-auth.1.ci.43" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.AppIdentity.HttpEndpoint\CK.AppIdentity.HttpEndpoint.csproj" />
  </ItemGroup>
</Project>